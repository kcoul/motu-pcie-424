<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- MOTU's own entitlement, preserved. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- The point of the exercise: let the 2017, SHA-1-signed PCI HALPlugin
	     load into this process. Without it, hardened runtime enforces library
	     validation and dyld refuses the plugin outright. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
